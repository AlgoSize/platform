# Algosize — environment variable reference.
# Worker secrets are NOT loaded from this file in production. Use:
#   cd worker && wrangler secret put <NAME>
# This file just documents what each secret is for so a new operator
# knows what to provision.

# --- Stripe ---
# Test keys for local dev, live keys for production. Never commit real values.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Price ID for the monthly subscription plan.
STRIPE_PRICE_ID=price_replace_me

# --- Auth ---
# 32+ random bytes, hex or base64. Used to sign session JWTs.
JWT_SECRET=replace_with_long_random_string

# --- Cloudflare KV namespace IDs ---
# Created with `wrangler kv:namespace create SESSIONS` and `... USERS`,
# then pasted into worker/wrangler.toml. Listed here only for the operator.
KV_SESSIONS_ID=
KV_USERS_ID=

# --- Site ---
# Origin the Worker should allow via CORS.
SITE_ORIGIN=http://localhost:5000

# Cookie name used for the session JWT (set by the Stripe webhook in Task #4,
# read by requireAuth on every protected route).
COOKIE_NAME=algosize_session

# --- MCP client (NOT a Worker secret) ---
# Everything above is provisioned with `wrangler secret put`. These two are the
# opposite direction: they are read by whatever MCP CLIENT connects TO Algosize
# — Claude Code, Claude Desktop, Cursor — and never by the Worker. Do not put
# them in wrangler; put them in your shell, or in your MCP client's own env
# block.
#
# .mcp.json at the repo root (and .cursor/mcp.json) already declares the server
# and reads both from the environment, so exporting ALGOSIZE_API_KEY is the only
# step needed to use the tools from inside this repository.
#
# Required. Created at https://algosize.com/dashboard/#/account/keys and shown
# in full exactly once, at creation. The bridge rejects anything that does not
# begin with `ask_live_` before it opens a connection (mcp/src/bridge.mjs).
# An API key authenticates as the ORGANISATION, not as a person.
ALGOSIZE_API_KEY=ask_live_your_key_here

# Optional. Only set this to point a client at a non-production deployment;
# it defaults to https://algosize.com and the endpoint is <base>/api/mcp.
# ALGOSIZE_BASE_URL=https://algosize.com
